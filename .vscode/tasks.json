{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "启动 Vite 开发服务器并拉起 Electron",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "typecheck",
      "detail": "tsc --noEmit",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "lint",
      "detail": "ESLint",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "test",
      "detail": "Vitest 单测",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": []
    },
    {
      "label": "build",
      "detail": "类型检查 + 生产构建（dist / dist-electron）",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "package",
      "detail": "构建安装包（electron-builder）",
      "type": "shell",
      "command": "npm run package",
      "problemMatcher": []
    }
  ]
}
